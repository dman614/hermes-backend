# Home Services Platform - Environment Configuration
# Copy this to .env and fill in your actual keys

# ============================================================================
# OPENAI API (for LLM/Agent)
# ============================================================================
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# ============================================================================
# TWILIO (for Phone Calls & SMS)
# ============================================================================
# Get yours at: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1250555XXXX

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
# For local development:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hermes_db

# For production (Render, Railway, etc):
# DATABASE_URL=postgresql://user:password@host:5432/hermes_prod

# ============================================================================
# STRIPE (for Billing - Week 4)
# ============================================================================
# Get yours at: https://stripe.com
STRIPE_API_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENV=development
DEBUG=True
LOG_LEVEL=INFO
